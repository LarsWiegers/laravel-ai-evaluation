{
    "name": "larswiegers/laravel-ai-evaluation",
    "description": "Run AI/LLM evals for your AI features",
    "keywords": [
        "laravel",
        "ai",
        "llm",
        "evals",
        "testing"
    ],
    "homepage": "https://github.com/larswiegers/laravel-ai-evaluation",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Lars Wiegers",
            "email": "larswiegers@live.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": ">=0.5.0 <1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.5",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelAIEvaluation\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --exclude-group=live-ai",
        "test-live": "vendor/bin/pest --group=live-ai",
        "test-coverage": "vendor/bin/pest --coverage-html coverage",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelAIEvaluation\\LaravelAIEvaluationServiceProvider"
            ]
        }
    }
}
